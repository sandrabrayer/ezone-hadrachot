# --- Required ---

# Apps Script Web App URL of the HADRACHOT backend (the one ending in /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Shared secret. MUST match the SHARED_SECRET set in the hadrachot Apps
# Script's Script Properties. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARED_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# App PIN (string, 4-12 chars; use digits only for keypad UX)
APP_PIN=REPLACE_ME

# Secret used to sign session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# The STAFFING app's Apps Script /exec URL — the read-only guide roster feed
# (doGet?action=getGuidesForHadrachot). Guides are NEVER stored in this app;
# every page load fetches them live through server.js. Fail-closed: while
# unset the /api/guides route answers 503 and the UI shows an error, never an
# empty roster.
STAFFING_GUIDES_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# MUST match the HADRACHOT_READ_SECRET Script Property in the STAFFING
# Apps Script project. Only ever sent server-side; the browser never sees it.
HADRACHOT_READ_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# --- Optional ---

# Port (Railway sets this automatically)
PORT=3000

# Session lifetime in days (default 7)
SESSION_DAYS=7
